# ESP32-S3. Native USB-Serial-JTAG, so the console is on the USB port and there
# is no secondary output to confuse a terminal.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Same main-task stack as the C3: app_main holds the 4 kB configuration buffer.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# --- PSRAM -----------------------------------------------------------------
# 2 MB quad SPI (ESP32-S3R2). Quad mode leaves GPIO33-37 free; GPIO26-32 belong
# to the flash and PSRAM either way. Nothing here needs external RAM: internal
# heap is still preferred, and only allocations too large for it, or made
# explicitly with MALLOC_CAP_SPIRAM, land in PSRAM. That keeps the sampling
# path and the WiFi/LwIP buffers at internal-RAM speed.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# A bad PSRAM chip should be a loud boot failure, not a silently smaller heap.
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
